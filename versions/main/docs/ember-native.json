{"id":15,"name":"declarations/modifiers","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/modifiers/index.d.ts","line":1,"character":0}]},{"id":16,"name":"declarations/modifiers/native-slot","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/modifiers/native-slot.d.ts","line":1,"character":0}]},{"id":3,"name":"declarations/native-application","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/native-application.d.ts","line":1,"character":0}]},{"id":17,"name":"declarations/services/history","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/services/history.d.ts","line":1,"character":0}]},{"id":18,"name":"declarations/services/native-router","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/services/native-router.d.ts","line":1,"character":0}]},{"id":6,"name":"declarations/setup","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/setup.d.ts","line":1,"character":0}]},{"id":4,"name":"declarations/setup-app","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/setup-app.d.ts","line":1,"character":0}]},{"id":5,"name":"declarations/setup-inspector-support","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/setup-inspector-support.d.ts","line":1,"character":0}]},{"id":19,"name":"declarations/types/glint","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/types/glint.d.ts","line":1,"character":0}]}],"groups":[{"title":"Modules","children":[1,10,7,8,9,2,11,12,20,21,22,23,24,25,26,27,28,13,14,15,16,3,17,18,6,4,5,19]}],"packageName":"ember-native","readme":[{"kind":"text","text":"ember-native\n==============================================================================\n\nuse the Ember framework with Nativescript \n\n\n"},{"kind":"code","text":"`ember-native-nativescript`"},{"kind":"text","text":" binary\n------------------------------------------------------------------------------\n\nThis package installs a "},{"kind":"code","text":"`ember-native-nativescript`"},{"kind":"text","text":" binary alongside the\n"},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":" CLI it depends on. It's a thin wrapper: it forwards all\narguments unchanged to "},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":"/"},{"kind":"code","text":"`tns`"},{"kind":"text","text":", but also works around a real bug\nin "},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":"'s CLI (confirmed still present as of "},{"kind":"code","text":"`nativescript@9.0.6`"},{"kind":"text","text":",\nthe latest stable release at the time of writing - see\n["},{"kind":"code","text":"`NativeScript/nativescript-cli`"},{"kind":"text","text":"](https://github.com/NativeScript/nativescript-cli)):\n"},{"kind":"code","text":"`nativescript build`"},{"kind":"text","text":"/"},{"kind":"code","text":"`nativescript test`"},{"kind":"text","text":" never copy "},{"kind":"code","text":"`@nativescript/vite`"},{"kind":"text","text":"'s\nbuild output into the native platform project, silently producing an empty\nor stale native app. Only "},{"kind":"code","text":"`nativescript debug`"},{"kind":"text","text":"'s watch-mode path happens to\ncopy it correctly. No tracking issue could be found upstream for this bug at\nthe time of writing.\n\nIf your app uses "},{"kind":"code","text":"`@nativescript/vite`"},{"kind":"text","text":", point your "},{"kind":"code","text":"`package.json`"},{"kind":"text","text":" scripts at\n"},{"kind":"code","text":"`ember-native-nativescript`"},{"kind":"text","text":" instead of "},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":"/"},{"kind":"code","text":"`tns`"},{"kind":"text","text":" directly - it\notherwise behaves identically, and becomes a no-op the moment upstream ships\na real fix (detected automatically, not hardcoded to a version). For example:\n\n"},{"kind":"code","text":"```json\n{\n  \"scripts\": {\n    \"run\": \"ember-native-nativescript debug android\",\n    \"test\": \"ember-native-nativescript test android --no-watch\",\n    \"build\": \"ember-native-nativescript build android\",\n    \"debug\": \"ember-native-nativescript debug android --debug-brk\",\n    \"prepare-android\": \"ember-native-nativescript prepare android\"\n  }\n}\n```"},{"kind":"text","text":"\n\n"},{"kind":"code","text":"`ember-native-nativescript`"},{"kind":"text","text":" resolves "},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":" the same way "},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":"\nitself would: from the current working directory. Run it from your app's\nproject root (the directory that depends on "},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":"), the same place\nyou'd run "},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":" from - not from wherever "},{"kind":"code","text":"`ember-native`"},{"kind":"text","text":" happens to be\ninstalled. This also means it won't work as expected if invoked through a task\nrunner that changes "},{"kind":"code","text":"`cwd`"},{"kind":"text","text":" (e.g. Nx or Turborepo's "},{"kind":"code","text":"`--cwd`"},{"kind":"text","text":") to somewhere without\n"},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":" in scope.\n\n\nSetting up an app's "},{"kind":"code","text":"`vite.config.ts`"},{"kind":"text","text":"\n------------------------------------------------------------------------------\n\nAn ember-native app needs "},{"kind":"code","text":"`@nativescript/vite`"},{"kind":"text","text":"'s own config merged together\nwith a handful of Ember/Embroider- and ember-native-specific plugins and\nalias fixes. Rather than hand-rolling that merge (subtle to get right - see\n"},{"kind":"code","text":"`demo-app/vite.config.ts`"},{"kind":"text","text":" before this helper existed, in git history, for\nwhat that used to look like), use "},{"kind":"code","text":"`ember-native/utils/nativescript-vite.config.js`"},{"kind":"text","text":":\n\n"},{"kind":"code","text":"```ts\n// vite.config.ts\nimport { createRequire } from 'node:module';\nimport { defineConfig, mergeConfig } from 'vite';\nimport { typescriptConfig } from '@nativescript/vite';\nimport { hmr } from 'ember-vite-hmr';\nimport configureNativeScriptVite from 'ember-native/utils/nativescript-vite.config.js';\n\nconst require = createRequire(import.meta.url);\n\nexport default defineConfig(({ mode }) =>\n  configureNativeScriptVite({\n    mode,\n    mergeConfig,\n    typescriptConfig,\n    hmr,\n    require,\n    entry: require.resolve('./boot-app.js'),\n  }),\n);\n```"},{"kind":"text","text":"\n\n"},{"kind":"code","text":"`mergeConfig`"},{"kind":"text","text":"/"},{"kind":"code","text":"`typescriptConfig`"},{"kind":"text","text":"/"},{"kind":"code","text":"`hmr`"},{"kind":"text","text":"/"},{"kind":"code","text":"`require`"},{"kind":"text","text":" are passed through from your\nown imports (rather than re-imported inside the helper) so the exact "},{"kind":"code","text":"`vite`"},{"kind":"text","text":"\ninstance driving your dev server is always the one used - see the helper's\nown JSDoc for why that matters. "},{"kind":"code","text":"`entry`"},{"kind":"text","text":" points at whatever file your app's\n"},{"kind":"code","text":"`app/boot.js`"},{"kind":"text","text":" should actually run (see "},{"kind":"code","text":"`demo-app/app/boot.js`"},{"kind":"text","text":" for the\nbare-specifier-alias dispatcher pattern this enables).\n\nCustomize via extra options: "},{"kind":"code","text":"`vendorExclude`"},{"kind":"text","text":" (extra package names to skip in\n"},{"kind":"code","text":"`@nativescript/vite`"},{"kind":"text","text":"'s HMR vendor-bundle step - safe to over-list), "},{"kind":"code","text":"`hmrHost`"},{"kind":"text","text":"\n(override the Android-emulator HMR host guess for a real device or LAN dev\nserver), "},{"kind":"code","text":"`babel`"},{"kind":"text","text":" (forwarded into the addon's own babel plugin config),\n"},{"kind":"code","text":"`plugins`"},{"kind":"text","text":" (extra Vite plugins), and "},{"kind":"code","text":"`extend`"},{"kind":"text","text":" (any other Vite config,\nmerged in last). A one-shot bundler config that never runs the dev server\n(e.g. a Vite-only "},{"kind":"code","text":"`nativescript test`"},{"kind":"text","text":" config) just omits "},{"kind":"code","text":"`hmr`"},{"kind":"text","text":"/"},{"kind":"code","text":"`require`"},{"kind":"text","text":" -\nsee "},{"kind":"code","text":"`demo-app/vite.test.config.ts`"},{"kind":"text","text":" for a full example that also adds its own\ntest-only plugins, aliases, and "},{"kind":"code","text":"`define`"},{"kind":"text","text":"s via "},{"kind":"code","text":"`plugins`"},{"kind":"text","text":"/"},{"kind":"code","text":"`extend`"},{"kind":"text","text":".\n\n\nBootstrapping an app\n------------------------------------------------------------------------------\n\nAn ember-native app needs a handful of one-time wiring steps that are the\nsame for every app and easy to get subtly wrong (see git history for\n"},{"kind":"code","text":"`demo-app/app/native/setup-ember-native.ts`"},{"kind":"text","text":"/"},{"kind":"code","text":"`app/app.js`"},{"kind":"text","text":" before these helpers\nexisted). "},{"kind":"code","text":"`ember-native`"},{"kind":"text","text":" exports three functions/classes to cover them - the\nrest of each file below is genuinely app-specific and stays yours to write.\n\n"},{"kind":"code","text":"`app/native/setup-ember-native.ts`"},{"kind":"text","text":" (imported first, before anything else that\ntouches the DOM or Ember) just needs:\n\n"},{"kind":"code","text":"```ts\nimport { setupEmberNativeApp } from 'ember-native';\nimport { ENV } from '~/config/env';\n\nsetupEmberNativeApp(ENV);\n```"},{"kind":"text","text":"\n\n"},{"kind":"code","text":"`setupEmberNativeApp`"},{"kind":"text","text":" installs ember-native's DOM shim, wires up Chrome\nDevTools support in dev builds only (tree-shaken out of release builds), and\nsets "},{"kind":"code","text":"`ENV.rootElement`"},{"kind":"text","text":" to the app's root native view.\n\n"},{"kind":"code","text":"`app/app.js`"},{"kind":"text","text":"'s "},{"kind":"code","text":"`App`"},{"kind":"text","text":" class extends "},{"kind":"code","text":"`NativeApplication`"},{"kind":"text","text":" instead of\n"},{"kind":"code","text":"`@ember/application`"},{"kind":"text","text":" directly - it's the same class otherwise, with your own\n"},{"kind":"code","text":"`rootElement`"},{"kind":"text","text":"/"},{"kind":"code","text":"`modulePrefix`"},{"kind":"text","text":"/"},{"kind":"code","text":"`Resolver`"},{"kind":"text","text":"/etc:\n\n"},{"kind":"code","text":"```js\nimport { NativeApplication } from 'ember-native';\n\nexport default class App extends NativeApplication {\n  rootElement = ENV.rootElement;\n  autoboot = ENV.autoboot;\n  modulePrefix = ENV.modulePrefix;\n  podModulePrefix = `${ENV.modulePrefix}/pods`;\n  Resolver = Resolver.withModules(compatModules);\n}\n```"},{"kind":"text","text":"\n\n"},{"kind":"code","text":"`app/native/main.ts`"},{"kind":"text","text":" (your NativeScript entry point) creates and registers\nthe app instance via "},{"kind":"code","text":"`createNativeApplication`"},{"kind":"text","text":":\n\n"},{"kind":"code","text":"```ts\nimport './setup-ember-native';\nimport './register-elements'; // your own custom native elements, if any\nimport App from '../app';\nimport ENV from '~/config/env';\nimport { createNativeApplication } from 'ember-native';\n\nexport default createNativeApplication(App, ENV);\n```"},{"kind":"text","text":"\n\n\nContributing\n------------------------------------------------------------------------------\n\nSee the [Contributing]("},{"kind":"relative-link","text":"CONTRIBUTING.md"},{"kind":"text","text":") guide for details.\n\n\nLicense\n------------------------------------------------------------------------------\n\nThis project is licensed under the [MIT License]("},{"kind":"relative-link","text":"LICENSE.md","target":29},{"kind":"text","text":")."}],"symbolIdMap":{"1":{"packageName":"ember-native","packagePath":"declarations/index.d.ts","qualifiedName":""},"2":{"packageName":"ember-native","packagePath":"declarations/create-native-application.d.ts","qualifiedName":""},"3":{"packageName":"ember-native","packagePath":"declarations/native-application.d.ts","qualifiedName":""},"4":{"packageName":"ember-native","packagePath":"declarations/setup-app.d.ts","qualifiedName":""},"5":{"packageName":"ember-native","packagePath":"declarations/setup-inspector-support.d.ts","qualifiedName":""},"6":{"packageName":"ember-native","packagePath":"declarations/setup.d.ts","qualifiedName":""},"7":{"packageName":"ember-native","packagePath":"declarations/components/InspectorSupport.d.ts","qualifiedName":""},"8":{"packageName":"ember-native","packagePath":"declarations/components/ListView.d.ts","qualifiedName":""},"9":{"packageName":"ember-native","packagePath":"declarations/components/RadListView.d.ts","qualifiedName":""},"10":{"packageName":"ember-native","packagePath":"declarations/components/index.d.ts","qualifiedName":""},"11":{"packageName":"ember-native","packagePath":"declarations/dom/element-registry.d.ts","qualifiedName":""},"12":{"packageName":"ember-native","packagePath":"declarations/dom/native-elements-tag-name-map.d.ts","qualifiedName":""},"13":{"packageName":"ember-native","packagePath":"declarations/dom/setup-registry.d.ts","qualifiedName":""},"14":{"packageName":"ember-native","packagePath":"declarations/instance-initializers/history.d.ts","qualifiedName":""},"15":{"packageName":"ember-native","packagePath":"declarations/modifiers/index.d.ts","qualifiedN