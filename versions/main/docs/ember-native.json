{"schemaVersion":"2.0","id":0,"name":"ember-native","variant":"project","kind":1,"flags":{},"children":[{"id":1,"name":"declarations","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/index.d.ts","line":1,"character":0}]},{"id":11,"name":"declarations/components","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/components/index.d.ts","line":1,"character":0}]},{"id":8,"name":"declarations/components/InspectorSupport","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/components/InspectorSupport.d.ts","line":1,"character":0}]},{"id":9,"name":"declarations/components/ListView","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/components/ListView.d.ts","line":1,"character":0}]},{"id":10,"name":"declarations/components/RadListView","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/components/RadListView.d.ts","line":1,"character":0}]},{"id":13,"name":"declarations/components/tracked-map","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/components/tracked-map.d.ts","line":1,"character":0}]},{"id":12,"name":"declarations/components/tracked-map-glimmer","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/components/tracked-map-glimmer.d.ts","line":1,"character":0}]},{"id":14,"name":"declarations/components/tracked-map.test","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/components/tracked-map.test.d.ts","line":1,"character":0}]},{"id":2,"name":"declarations/create-native-application","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/create-native-application.d.ts","line":1,"character":0}]},{"id":15,"name":"declarations/dom/element-registry","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/dom/element-registry.d.ts","line":1,"character":0}]},{"id":16,"name":"declarations/dom/native-elements-tag-name-map","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/dom/native-elements-tag-name-map.d.ts","line":1,"character":0}]},{"id":28,"name":"declarations/dom/native/action-item-removal","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/dom/native/action-item-removal.d.ts","line":1,"character":0}]},{"id":29,"name":"declarations/dom/native/action-item-removal.test","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/dom/native/action-item-removal.test.d.ts","line":1,"character":0}]},{"id":25,"name":"declarations/dom/native/FrameElement","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/dom/native/FrameElement.d.ts","line":1,"character":0}]},{"id":26,"name":"declarations/dom/native/NativeElementNode","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/dom/native/NativeElementNode.d.ts","line":1,"character":0}]},{"id":27,"name":"declarations/dom/native/PageElement","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/dom/native/PageElement.d.ts","line":1,"character":0}]},{"id":30,"name":"declarations/dom/nodes/CommentNode","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/dom/nodes/CommentNode.d.ts","line":1,"character":0}]},{"id":31,"name":"declarations/dom/nodes/DocumentNode","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/dom/nodes/DocumentNode.d.ts","line":1,"character":0}]},{"id":32,"name":"declarations/dom/nodes/ElementNode","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/dom/nodes/ElementNode.d.ts","line":1,"character":0}]},{"id":33,"name":"declarations/dom/nodes/PropertyNode","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/dom/nodes/PropertyNode.d.ts","line":1,"character":0}]},{"id":34,"name":"declarations/dom/nodes/TextNode","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/dom/nodes/TextNode.d.ts","line":1,"character":0}]},{"id":35,"name":"declarations/dom/nodes/ViewNode","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/dom/nodes/ViewNode.d.ts","line":1,"character":0}]},{"id":17,"name":"declarations/dom/setup-registry","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/dom/setup-registry.d.ts","line":1,"character":0}]},{"id":18,"name":"declarations/instance-initializers/history","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/instance-initializers/history.d.ts","line":1,"character":0}]},{"id":3,"name":"declarations/maybe-setup-inspector-support","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/maybe-setup-inspector-support.d.ts","line":1,"character":0}]},{"id":19,"name":"declarations/modifiers","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/modifiers/index.d.ts","line":1,"character":0}]},{"id":20,"name":"declarations/modifiers/native-slot","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/modifiers/native-slot.d.ts","line":1,"character":0}]},{"id":4,"name":"declarations/native-application","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/native-application.d.ts","line":1,"character":0}]},{"id":21,"name":"declarations/services/history","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/services/history.d.ts","line":1,"character":0}]},{"id":22,"name":"declarations/services/native-router","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/services/native-router.d.ts","line":1,"character":0}]},{"id":7,"name":"declarations/setup","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/setup.d.ts","line":1,"character":0}]},{"id":5,"name":"declarations/setup-app","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/setup-app.d.ts","line":1,"character":0}]},{"id":6,"name":"declarations/setup-inspector-support","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/setup-inspector-support.d.ts","line":1,"character":0}]},{"id":24,"name":"declarations/test-support/with-template-for-testing","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/test-support/with-template-for-testing.d.ts","line":1,"character":0}]},{"id":23,"name":"declarations/types/glint","variant":"declaration","kind":2,"flags":{"isExternal":true},"sources":[{"fileName":"declarations/types/glint.d.ts","line":1,"character":0}]}],"groups":[{"title":"Modules","children":[1,11,8,9,10,13,12,14,2,15,16,28,29,25,26,27,30,31,32,33,34,35,17,18,3,19,20,4,21,22,7,5,6,24,23]}],"packageName":"ember-native","readme":[{"kind":"text","text":"ember-native\n==============================================================================\n\nuse the Ember framework with Nativescript \n\n\n"},{"kind":"code","text":"`ember-native-nativescript`"},{"kind":"text","text":" binary\n------------------------------------------------------------------------------\n\nThis package installs a "},{"kind":"code","text":"`ember-native-nativescript`"},{"kind":"text","text":" binary alongside the\n"},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":" CLI it depends on. It's a thin wrapper: it forwards all\narguments unchanged to "},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":"/"},{"kind":"code","text":"`tns`"},{"kind":"text","text":", but also works around a real bug\nin "},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":"'s CLI (confirmed still present as of "},{"kind":"code","text":"`nativescript@9.0.6`"},{"kind":"text","text":",\nthe latest stable release at the time of writing - see\n["},{"kind":"code","text":"`NativeScript/nativescript-cli`"},{"kind":"text","text":"](https://github.com/NativeScript/nativescript-cli)):\n"},{"kind":"code","text":"`nativescript build`"},{"kind":"text","text":"/"},{"kind":"code","text":"`nativescript test`"},{"kind":"text","text":" never copy "},{"kind":"code","text":"`@nativescript/vite`"},{"kind":"text","text":"'s\nbuild output into the native platform project, silently producing an empty\nor stale native app. Only "},{"kind":"code","text":"`nativescript debug`"},{"kind":"text","text":"'s watch-mode path happens to\ncopy it correctly. No tracking issue could be found upstream for this bug at\nthe time of writing.\n\nIf your app uses "},{"kind":"code","text":"`@nativescript/vite`"},{"kind":"text","text":", point your "},{"kind":"code","text":"`package.json`"},{"kind":"text","text":" scripts at\n"},{"kind":"code","text":"`ember-native-nativescript`"},{"kind":"text","text":" instead of "},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":"/"},{"kind":"code","text":"`tns`"},{"kind":"text","text":" directly - it\notherwise behaves identically, and becomes a no-op the moment upstream ships\na real fix (detected automatically, not hardcoded to a version). For example:\n\n"},{"kind":"code","text":"```json\n{\n  \"scripts\": {\n    \"run\": \"ember-native-nativescript debug android\",\n    \"test\": \"ember-native-nativescript test android --no-watch\",\n    \"build\": \"ember-native-nativescript build android\",\n    \"debug\": \"ember-native-nativescript debug android --debug-brk\",\n    \"prepare-android\": \"ember-native-nativescript prepare android\"\n  }\n}\n```"},{"kind":"text","text":"\n\n"},{"kind":"code","text":"`ember-native-nativescript`"},{"kind":"text","text":" resolves "},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":" the same way "},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":"\nitself would: from the current working directory. Run it from your app's\nproject root (the directory that depends on "},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":"), the same place\nyou'd run "},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":" from - not from wherever "},{"kind":"code","text":"`ember-native`"},{"kind":"text","text":" happens to be\ninstalled. This also means it won't work as expected if invoked through a task\nrunner that changes "},{"kind":"code","text":"`cwd`"},{"kind":"text","text":" (e.g. Nx or Turborepo's "},{"kind":"code","text":"`--cwd`"},{"kind":"text","text":") to somewhere without\n"},{"kind":"code","text":"`nativescript`"},{"kind":"text","text":" in scope.\n\n\nSetting up an app's "},{"kind":"code","text":"`vite.config.ts`"},{"kind":"text","text":"\n------------------------------------------------------------------------------\n\nAn ember-native app needs "},{"kind":"code","text":"`@nativescript/vite`"},{"kind":"text","text":"'s own config merged together\nwith a handful of Ember/Embroider- and ember-native-specific plugins and\nalias fixes. Rather than hand-rolling that merge (subtle to get right - see\n"},{"kind":"code","text":"`demo-app/vite.config.ts`"},{"kind":"text","text":" before this helper existed, in git history, for\nwhat that used to look like), use "},{"kind":"code","text":"`ember-native/utils/nativescript-vite.config.js`"},{"kind":"text","text":":\n\n"},{"kind":"code","text":"```ts\n// vite.config.ts\nimport { createRequire } from 'node:module';\nimport { defineConfig, mergeConfig } from 'vite';\nimport { typescriptConfig } from '@nativescript/vite';\nimport { hmr } from 'ember-vite-hmr';\nimport configureNativeScriptVite from 'ember-native/utils/nativescript-vite.config.js';\n\nconst require = createRequire(import.meta.url);\n\nexport default defineConfig(({ mode }) =>\n  configureNativeScriptVite({\n    mode,\n    mergeConfig,\n    typescriptConfig,\n    hmr,\n    require,\n    entry: require.resolve('./boot-app.js'),\n  }),\n);\n```"},{"kind":"text","text":"\n\n"},{"kind":"code","text":"`mergeConfig`"},{"kind":"text","text":"/"},{"kind":"code","text":"`typescriptConfig`"},{"kind":"text","text":"/"},{"kind":"code","text":"`hmr`"},{"kind":"text","text":"/"},{"kind":"code","text":"`require`"},{"kind":"text","text":" are passed through from your\nown imports (rather than re-imported inside the helper) so the exact "},{"kind":"code","text":"`vite`"},{"kind":"text","text":"\ninstance driving your dev server is always the one used - see the helper's\nown JSDoc for why that matters. "},{"kind":"code","text":"`entry`"},{"kind":"text","text":" points at whatever file your app's\n"},{"kind":"code","text":"`app/boot.js`"},{"kind":"text","text":" should actually run (see "},{"kind":"code","text":"`demo-app/app/boot.js`"},{"kind":"text","text":" for the\nbare-specifier-alias dispatcher pattern this enables).\n\nCustomize via extra options: "},{"kind":"code","text":"`vendorExclude`"},{"kind":"text","text":" (extra package names to skip in\n"},{"kind":"code","text":"`@nativescript/vite`"},{"kind":"text","text":"'s HMR vendor-bundle step - safe to over-list), "},{"kind":"code","text":"`hmrHost`"},{"kind":"text","text":"\n(override the Android-emulator HMR host guess for a real device or LAN dev\nserver), "},{"kind":"code","text":"`babel`"},{"kind":"text","text":" (forwarded into the addon's own babel plugin config),\n"},{"kind":"code","text":"`plugins`"},{"kind":"text","text":" (extra Vite plugins), and "},{"kind":"code","text":"`extend`"},{"kind":"text","text":" (any other Vite config,\nmerged in last). A one-shot bundler config that never runs the dev server\n(e.g. a Vite-only "},{"kind":"code","text":"`nativescript test`"},{"kind":"text","text":" config) just omits "},{"kind":"code","text":"`hmr`"},{"kind":"text","text":"/"},{"kind":"code","text":"`require`"},{"kind":"text","text":" -\nsee "},{"kind":"code","text":"`demo-app/vite.test.config.ts`"},{"kind":"text","text":" for a full example that also adds its own\ntest-only plugins, aliases, and "},{"kind":"code","text":"`define`"},{"kind":"text","text":"s via "},{"kind":"code","text":"`plugins`"},{"kind":"text","text":"/"},{"kind":"code","text":"`extend`"},{"kind":"text","text":".\n\n\nBootstrapping an app\n------------------------------------------------------------------------------\n\nAn ember-native app needs a handful of one-time wiring steps that are the\nsame for every app and easy to get subtly wrong (see git history for\n"},{"kind":"code","text":"`demo-app/app/native/setup-ember-native.ts`"},{"kind":"text","text":"/"},{"kind":"code","text":"`app/app.js`"},{"kind":"text","text":" before these helpers\nexisted). "},{"kind":"code","text":"`ember-native`"},{"kind":"text","text":" exports three functions/classes to cover them - the\nrest of each file below is genuinely app-specific and stays yours to write.\n\n"},{"kind":"code","text":"`app/native/setup-ember-native.ts`"},{"kind":"text","text":" (imported first, before anything else that\ntouches the DOM or Ember) just needs:\n\n"},{"kind":"code","text":"```ts\nimport { setupEmberNativeApp } from 'ember-native';\nimport { ENV } from '~/config/env';\n\nsetupEmberNativeApp(ENV);\n```"},{"kind":"text","text":"\n\n"},{"kind":"code","text":"`setupEmberNativeApp`"},{"kind":"text","text":" installs ember-native's DOM shim, wires up Chrome\nDevTools support in dev builds only via "},{"kind":"code","text":"`maybeSetupInspectorSupport`"},{"kind":"text","text":" (see\nbelow), and sets "},{"kind":"code","text":"`ENV.rootElement`"},{"kind":"text","text":" to the app's root native view.\n\n"},{"kind":"code","text":"`app/app.js`"},{"kind":"text","text":"'s "},{"kind":"code","text":"`App`"},{"kind":"text","text":" class extends "},{"kind":"code","text":"`NativeApplication`"},{"kind":"text","text":" instead of\n"},{"kind":"code","text":"`@ember/application`"},{"kind":"text","text":" directly - it's the same class otherwise, with your own\n"},{"kind":"code","text":"`rootElement`"},{"kind":"text","text":"/"},{"kind":"code","text":"`modulePrefix`"},{"kind":"text","text":"/"},{"kind":"code","text":"`Resolver`"},{"kind":"text","text":"/etc:\n\n"},{"kind":"code","text":"```js\nimport { NativeApplication } from 'ember-native';\n\nexport default class App extends NativeApplication {\n  rootElement = ENV.rootElement;\n  autoboot = ENV.autoboot;\n  modulePrefix = ENV.modulePrefix;\n  podModulePrefix = `${ENV.modulePrefix}/pods`;\n  Resolver = Resolver.withModules(compatModules);\n}\n```"},{"kind":"text","text":"\n\n"},{"kind":"code","text":"`app/native/main.ts`"},{"kind":"text","text":" (your NativeScript entry point) creates and registers\nthe app instance via "},{"kind":"code","text":"`createNativeApplication`"},{"kind":"text","text":":\n\n"},{"kind":"code","text":"```ts\nimport './setup-ember-native';\nimport './register-elements'; // your own custom native elements, if any\nimport App from '../app';\nimport ENV from '~/config/env';\nimport { createNativeApplication } from 'ember-native';\n\nexport default createNativeApplication(App, ENV);\n```"},{"kind":"text","text":"\n\n\nChrome DevTools support\n------------------------------------------------------------------------------\n\n"},{"kind":"code","text":"`setupEmberNativeApp`"},{"kind":"text","text":" already wires up Chrome DevTools protocol support for\nyou, so most apps don't need to think about this at all. It only matters if\nyou have a custom entry point that doesn't go through "},{"kind":"code","text":"`setupEmberNativeApp`"},{"kind":"text","text":"\n(or you want to trigger inspector support separately, e.g. later than app\nboot) and need to call it yourself - use "},{"kind":"code","text":"`maybeSetupInspectorSupport`"},{"kind":"text","text":":\n\n"},{"kind":"code","text":"```ts\nimport { maybeSetupInspectorSupport } from 'ember-native';\nimport { ENV } from '~/config/env';\n\nmaybeSetupInspectorSupport(ENV);\n```"},{"kind":"text","text":"\n\nThis is a no-op in release builds, tree-shaken out of the bundle entirely\nrather than merely skipped at runtime. That distinction matters: the module\n"},{"kind":"code","text":"`maybeSetupInspectorSupport`"},{"kind":"text","text":" loads under the hood\n("},{"kind":"code","text":"`ember-native/setup-inspector-support`"},{"kind":"text","text":") statically imports\n"},{"kind":"code","text":"`@nativescript/core/debugger/webinspector-dom`"},{"kind":"text","text":", which throws the moment it's\nevaluated on NativeScript's plain (non-"},{"kind":"code","text":"`-with-inspector`"},{"kind":"text","text":") release runtime.\nBecause ES module imports are hoisted, wrapping a static "},{"kind":"code","text":"`import`"},{"kind":"text","text":" of that\nmodule in a runtime "},{"kind":"code","text":"`if (__DEV__)`"},{"kind":"text","text":" check doesn't help - the import still runs\nand crashes before the guard ever executes. "},{"kind":"code","text":"`maybeSetupInspectorSupport`"},{"kind":"text","text":"\nperforms the import as a dynamic "},{"kind":"code","text":"`import()`"},{"kind":"text","text":" internally, gated on\n"},{"kind":"code","text":"`import.meta.env.DEV`"},{"kind":"text","text":", so Rollup can prove the whole branch is dead code in a\nproduction build and drop it instead of merely deferring it. Prefer this\nhelper over importing "},{"kind":"code","text":"`ember-native/setup-inspector-support`"},{"kind":"text","text":" directly -\nthat module's own "},{"kind":"code","text":"`setupInspectorSupport`"},{"kind":"text","text":" export is only safe behind this\nexact dynamic-import pattern, and getting it wrong silently breaks every\nrelease build that imports the module path at all, even unconditionally at\nthe top of an otherwise-unrelated file.\n\n\nTesting page-rooted components\n------------------------------------------------------------------------------\n\nA NativeScript "},{"kind":"code","text":"`Page`"},{"kind":"text","text":" only gets a working "},{"kind":"code","text":"`.frame`"},{"kind":"text","text":" (and, by extension, a\nworking "},{"kind":"code","text":"`<action-bar>`"},{"kind":"text","text":") when it is a direct native child of a "},{"kind":"code","text":"`<frame>`"},{"kind":"text","text":"\nelement - see "},{"kind":"code","text":"`Page.frame`"},{"kind":"text","text":"/"},{"kind":"code","text":"`isFrame`"},{"kind":"text","text":" in "},{"kind":"code","text":"`@nativescript/core`"},{"kind":"text","text":", and\n"},{"kind":"code","text":"`ember-native/src/dom/native/FrameElement.ts`"},{"kind":"text","text":" for how "},{"kind":"code","text":"`<frame>`"},{"kind":"text","text":" wires a\n"},{"kind":"code","text":"`<page>`"},{"kind":"text","text":" child up via "},{"kind":"code","text":"`Frame.navigate()`"},{"kind":"text","text":". Every top-level route/screen\ncomponent in an ember-native app renders a "},{"kind":"code","text":"`<page>`"},{"kind":"text","text":" (see\n"},{"kind":"code","text":"`demo-app/app/routes/index.gts`"},{"kind":"text","text":"), but "},{"kind":"code","text":"`setupRenderingTest`"},{"kind":"text","text":" from "},{"kind":"code","text":"`ember-qunit`"},{"kind":"text","text":"\nnever provides a "},{"kind":"code","text":"`<frame>`"},{"kind":"text","text":" ancestor - rendering such a component directly\ncrashes with "},{"kind":"code","text":"`TypeError: page.frame._getNavBarVisible is not a function`"},{"kind":"text","text":" the\nmoment its "},{"kind":"code","text":"`<action-bar>`"},{"kind":"text","text":" loads.\n\nGlimmer templates are compiled statically, so a component's real template\ncan't be introspected or have its "},{"kind":"code","text":"`<page>`"},{"kind":"text","text":" wrapper stripped at runtime.\nInstead, use "},{"kind":"code","text":"`withTemplateForTest`"},{"kind":"text","text":" (from\n"},{"kind":"code","text":"`ember-native/test-support/with-template-for-testing`"},{"kind":"text","text":") to render a test-only\ndouble of the component with a substitute template - the same content minus\nthe "},{"kind":"code","text":"`<page>`"},{"kind":"text","text":"/"},{"kind":"code","text":"`<action-bar>`"},{"kind":"text","text":" wrapper - while keeping the original class's\nservices, args, and lifecycle intact:\n\n"},{"kind":"code","text":"`withTemplateForTest`"},{"kind":"text","text":" takes a component class, so a route module built with\n"},{"kind":"code","text":"`ember-routable-component`"},{"kind":"text","text":"'s "},{"kind":"code","text":"`RoutableComponentRoute()`"},{"kind":"text","text":" needs to export the\n"},{"kind":"code","text":"`<page>`"},{"kind":"text","text":"-rooted component itself, not just the generated "},{"kind":"code","text":"`Route`"},{"kind":"text","text":" (see\n"},{"kind":"code","text":"`demo-app/app/routes/index.gts`"},{"kind":"text","text":", which exports both "},{"kind":"code","text":"`Page`"},{"kind":"text","text":" and the\n"},{"kind":"code","text":"`IndexRoute`"},{"kind":"text","text":" built from it):\n\n"},{"kind":"code","text":"```gts\n// my-app/routes/index.gts\nimport RoutableComponentRoute from 'ember-routable-component';\nimport Component from '@glimmer/component';\n\nexport class Page extends Component {\n  <template>\n    <page>\n      <action-bar title=\"Ember Nativescript Examples\"></action-bar>\n      <stack-layout>\n        {{! ... }}\n      </stack-layout>\n    </page>\n  </template>\n}\n\nexport default class IndexRoute extends RoutableComponentRoute(Page) {}\n```"},{"kind":"text","text":"\n\n"},{"kind":"code","text":"```gts\nimport { setupRenderingTest } from 'my-app/tests/helpers';\nimport { render } from '@ember/test-helpers';\nimport { withTemplateForTest } from 'ember-native/test-support/with-template-for-testing';\nimport { Page as IndexPage } from 'my-app/routes/index';\n\nQUnit.module('Integration | Component | index page', function (hooks) {\n  setupRenderingTest(hooks);\n\n  QUnit.test('renders the list of examples', async function (assert) {\n    const TestableIndexPage = withTemplateForTest(IndexPage, <template>\n      <stack-layout>\n        {{! ...same content as IndexPage's template, minus <page>/<action-bar> }}\n      </stack-layout>\n    </template>);\n\n    await render(<template><TestableIndexPage /></template>);\n    assert.dom(this.element).containsText('List View');\n  });\n});\n```"},{"kind":"text","text":"\n\nThis only exercises the component's non-"},{"kind":"code","text":"`<page>`"},{"kind":"text","text":" content - it can't verify\n"},{"kind":"code","text":"`<action-bar>`"},{"kind":"text","text":" rendering or real navigation-frame behavior. Test those\nend-to-end instead, via "},{"kind":"code","text":"`setupApplicationTest`"},{"kind":"text","text":" + "},{"kind":"code","text":"`visit()`"},{"kind":"text","text":" (see\n"},{"kind":"code","text":"`demo-app/app/tests/integration/main-page-test.ts`"},{"kind":"text","text":"), which boots the real\napp and its native "},{"kind":"code","text":"`Application`"},{"kind":"text","text":".\n\n\nContributing\n------------------------------------------------------------------------------\n\nSee the [Contributing]("},{"kind":"relative-link","text":"CONTRIBUTING.md"},{"kind":"text","text":") guide for details.\n\n\nLicense\n------------------------------------------------------------------------------\n\nThis project is licensed under the [MIT License]("},{"kind":"relative-link","text":"LICENSE.md","target":36},{"kind":"text","text":")."}],"symbolIdMap":{"1":{"packageName":"ember-native","packagePath":"declarations/index.d.ts","qualifiedName":""},"2":{"packageName":"ember-native","packagePath":"