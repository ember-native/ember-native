{
  "name": "ember-native-root",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:ember-native/ember-native.git"
  },
  "license": "MIT",
  "author": "",
  "scripts": {
    "_start:docs": "pnpm --filter docs-app start",
    "build": "pnpm --filter docs-app --filter ember-native build",
    "lint": "pnpm --filter '*' lint",
    "lint:fix": "pnpm --filter docs-app --filter ember-native lint:fix",
    "start": "pnpm build; concurrently 'npm:_start:*' --prefix ' ' --restart-after 5000 --restart-tries -1",
    "test": "turbo run test --output-logs errors-only"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-syntax-typescript": "^7.28.0",
    "@glint/core": "^1.5.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "prettier-plugin-ember-template-tag": "^2.1.0",
    "release-plan": "^0.17.4",
    "typescript": "^5.9.2",
    "wait-on": "^9.0.0"
  },
  "engines": {
    "node": ">= 20.*",
    "npm": "use pnpm",
    "yarn": "use pnpm"
  },
  "pnpm": {
    "overrides": {
      "@embroider/addon-shim": "1.9.0"
    },
    "onlyBuiltDependencies": [
      "@nativescript/core",
      "@parcel/watcher",
      "chromedriver",
      "core-js",
      "core-js-pure",
      "esbuild",
      "nativescript",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.23.0",
  "volta": {
    "node": "24.14.1",
    "pnpm": "10.23.0"
  }
}
